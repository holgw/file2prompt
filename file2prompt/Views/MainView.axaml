<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:file2prompt.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="file2prompt.Views.MainView"
             x:DataType="vm:MainViewModel"
			 Background="{DynamicResource BackgroundBrush}"
			 x:Name="ThisControl"
			 xmlns:presets="clr-namespace:file2prompt.Core.UseCases.Common.Tools.PresetsManagement;assembly=file2prompt.Core"
			 xmlns:prompts="clr-namespace:file2prompt.Core.UseCases.Common.Tools.PromptsManagement;assembly=file2prompt.Core">
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
				to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto, Auto, *, Auto" Margin="10">

		<!--PRESETS-->
		<Grid Grid.Row="0" ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto">

			<!--HEADER-->
			<Label Grid.Column="0" Classes="H2" Margin="0 4 0 0">󰹕 Presets</Label>

			<!--PRESET SELECTION ROW-->
			<Grid Grid.Row="1" ColumnDefinitions="70, *, Auto, Auto, Auto" RowDefinitions="27">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">Preset</TextBlock>

				<ComboBox ItemsSource="{Binding Presets, Mode=TwoWay}"
					SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
					Grid.Column="1"
					PlaceholderText="Choose One"
					HorizontalAlignment="Stretch"
					SelectionChanged="ComboBox_SelectionChanged">
					<ComboBox.ItemTemplate>
						<DataTemplate DataType="{x:Type presets:Preset}">
							<TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!--SAVE-->
				<Button Command="{Binding SavePresetCommand}"
					Grid.Column="2"
					Margin="4 0 0 0"
					Height="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Save current settings to selected preset">
					<Button.Content>
						<Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" FontSize="20" Margin="0" Padding="4 0 0 0">󰆓</TextBlock>
							<TextBlock Grid.Column="1" Margin="0" Padding="4">Save</TextBlock>
						</Grid>
					</Button.Content>
				</Button>

				<!--SAVE NEW-->
				<Button Command="{Binding ShowNewPresetNameInputCommand}"
					Grid.Column="3"
					Margin="4 0 0 0"
					Height="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Create a new preset with current settings">
					<Button.Content>
						<Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" FontSize="20" Margin="0" Padding="4 0 0 0">󰸧</TextBlock>
							<TextBlock Grid.Column="1" Margin="0" Padding="4">Save New</TextBlock>
						</Grid>
					</Button.Content>
				</Button>

				<!--DELETE-->
				<Button Command="{Binding DeletePresetCommand}"
					Grid.Column="4"
					Margin="4 0 0 0"
					Height="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Delete selected preset">
					<Button.Content>
						<Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" FontSize="20" Margin="0" Padding="4 0 0 0">󰆴</TextBlock>
							<TextBlock Grid.Column="1" Margin="0" Padding="4">Delete</TextBlock>
						</Grid>
					</Button.Content>
				</Button>
			</Grid>

			<!--EDITABLE ROW-->
			<Grid Grid.Row="2" IsVisible="{Binding IsNewPresetNameInputVisible}" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto">
				<TextBox Grid.Column="0"
					Text="{Binding NewPresetName}"
					Margin="4 4 0 0"
					Height="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Enter name for new preset"/>

				<Button Command="{Binding SaveNewPresetCommand}"
					Grid.Column="1"
					Margin="4 4 0 0"
					FontSize="20"
					Width="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Save new preset with entered name"></Button>

				<Button Command="{Binding CancelSaveNewPresetCommand}"
					Grid.Column="2"
					Margin="4 4 0 0"
					FontSize="20"
					Width="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Cancel creating new preset"></Button>
			</Grid>

		</Grid>

		<!--CONNECTION-->
		<Grid Grid.Row="1" ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto, Auto">

			<!--HEADER-->
			<Label Grid.Column="0" Classes="H2">󱘖 Connection</Label>

			<!--URL-->
			<Grid Grid.Row="1" ColumnDefinitions="70, *, Auto" RowDefinitions="27">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">URL</TextBlock>

				<TextBox Grid.Column="1" Text="{Binding Url}"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Enter the API endpoint URL"/>

				<Button Command="{Binding TestConnectionCommand}"
					Grid.Column="2"
					Margin="4 0 0 0"
					FontSize="20"
					Width="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Test connection">󰙨</Button>
			</Grid>

			<!--API KEY-->
			<Grid Grid.Row="2" ColumnDefinitions="70, *" RowDefinitions="27" Margin="0 4 0 0">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">API Key</TextBlock>

				<TextBox Grid.Column="1" Text="{Binding ApiKey}"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Enter your API key for authentication"/>
			</Grid>

			<!--MODEL-->
			<Grid Grid.Row="3" ColumnDefinitions="70, *" RowDefinitions="27" Margin="0 4 0 0">
				<TextBlock Grid.Column="0" Classes="Default"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}"
					Text="Model"/>

				<TextBox Grid.Column="1" Text="{Binding Model}"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Enter the model name to use for inference"/>
			</Grid>
		</Grid>

		<!--PROCESSING-->
		<Grid Grid.Row="2" ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto, Auto">

			<!--HEADER-->
			<Label Grid.Row="0" Classes="H2"> Processing</Label>

			<!--WORKING DIRECTORY-->
			<Grid Grid.Row="1" ColumnDefinitions="70, *, Auto" RowDefinitions="27">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left" VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">Folder</TextBlock>

				<TextBox Text="{Binding WorkingDirectory}"
					Grid.Column="1"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Path to the folder with processed files"/>

				<Button Command="{Binding OpenFolderCommand}"
					Grid.Column="2"
					Margin="4 0 0 0"
					FontSize="16"
					Width="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Open working directory"></Button>
			</Grid>

			<!--REGEX-->
			<Grid Grid.Row="2" ColumnDefinitions="70, *, Auto" RowDefinitions="27" Margin="0 4 0 0">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left" VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">Regex</TextBlock>

				<TextBox Text="{Binding Regex}"
					Grid.Column="1"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Regular expression for searching files"/>

				<Button Command="{Binding TestFileSearchCommand}"
					Grid.Column="2"
					Margin="4 0 0 0"
					FontSize="20"
					Width="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Test file search with current regex">󰙨</Button>
			</Grid>

			<!--PROMPT-->
			<Grid Grid.Row="3" ColumnDefinitions="70, *, Auto" RowDefinitions="27"  Margin="0 4 0 0">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">Template</TextBlock>

				<ComboBox ItemsSource="{Binding Prompts, Mode=TwoWay}"
					SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
					Grid.Column="1"
					PlaceholderText="Choose One"
					HorizontalAlignment="Stretch">
					<ComboBox.ItemTemplate>
						<DataTemplate DataType="{x:Type prompts:PromptInfo}">
							<TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<Button Command="{Binding OpenTemplatesFolderCommand}"
					Grid.Column="2"
					Margin="4 0 0 0"
					FontSize="16"
					Width="27"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Open templates folder"></Button>
			</Grid>
		</Grid>

		<!--POST-PROCESSING-->
		<Grid Grid.Row="3" ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto, Auto">

			<!--HEADER-->
			<Label Grid.Row="0" Classes="H2"> Post-Processing</Label>

			<!--START TAG-->
			<Grid Grid.Row="1" ColumnDefinitions="80, *" RowDefinitions="27">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left" VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">Start Tag</TextBlock>

				<TextBox Grid.Column="1" Text="{Binding StartTag}"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Tag to mark the beginning of processed content"/>
			</Grid>

			<!--END TAG-->
			<Grid Grid.Row="2" Margin="0 4 0 0" ColumnDefinitions="80, *" RowDefinitions="27">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left" VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">End Tag</TextBlock>

				<TextBox Grid.Column="1" Text="{Binding EndTag}"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Tag to mark the end of processed content"/>
			</Grid>

			<!--FILE POSTFIX-->
			<Grid Grid.Row="3" Margin="0 4 0 0" ColumnDefinitions="150, *" RowDefinitions="27">
				<TextBlock Classes="Default"
					Grid.Column="0"
					HorizontalAlignment="Left" VerticalAlignment="Center"
					Foreground="{DynamicResource FadeTextBrush}">Result File Postfix</TextBlock>

				<TextBox Text="{Binding OutputFilePostfix}"
					Grid.Column="1"
					ToolTip.VerticalOffset="1"
					ToolTip.Placement="Bottom"
					ToolTip.Tip="Add a custom suffix to your result file names (e.g., &quot;_processed&quot; or &quot;-final&quot;). This suffix will replace the original file extension with your specified one. Leave blank to keep the original extension."/>
			</Grid>
		</Grid>

		<!--OUTPUT-->
		<Grid Grid.Row="4" RowDefinitions="Auto, *">

			<Grid Grid.Row="0" ColumnDefinitions="Auto, Auto">
				<Label Grid.Column="0" Classes="H2"> Output</Label>
			</Grid>

			<TextBox Grid.Row="1" Text="{Binding Output}"
				VerticalAlignment="Stretch"
				AcceptsReturn="True"
				TextWrapping="Wrap"
				IsReadOnly="False"
				MinHeight="20"
				ScrollViewer.VerticalScrollBarVisibility="Auto"/>
		</Grid>

		<!--LAUNCH-->
		<Grid Grid.Row="5" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto">
			<ProgressBar Grid.Column="0" Grid.Row="0" Margin="0 4" Height="27"
				Minimum="0" Maximum="100" Value="{Binding Progress}"
				Foreground="{StaticResource FadeAccentBrush}"
				ShowProgressText="False"
				CornerRadius="0"/>

			<Button Grid.Column="1"
				Command="{Binding OpenOutputFolderCommand}"
				Width="27"
				VerticalAlignment="Bottom"
				Margin="4 0 0 4"
				FontSize="16"
				ToolTip.VerticalOffset="1"
				ToolTip.Placement="Bottom"
				ToolTip.Tip="Open output folder"></Button>

			<Button Grid.Column="2" Width="100" Command="{Binding StartProcessingCommand}" Margin="4 0 0 0">
				<Button.Content>
					<Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto">
						<TextBlock Grid.Column="0" FontSize="14" Margin="0" Padding="4 6 4 0"></TextBlock>
						<TextBlock Grid.Column="1" Padding="4">Start</TextBlock>
					</Grid>
				</Button.Content>
			</Button>

			<Button Grid.Column="3"
				Command="{Binding AbortInferenceCommand}"
				IsVisible="{Binding IsProcessingNow}"
				Width="27"
				FontSize="16"
				Margin="4 0 0 0"
				Content="󰜺"
				ToolTip.VerticalOffset="1"
				ToolTip.Placement="Bottom"
				ToolTip.Tip="Abort current processing"/>
		</Grid>

	</Grid>
</UserControl>
